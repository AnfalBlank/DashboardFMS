# ==============================================================================
# FUEL MONITORING & MANAGEMENT SYSTEM — ENVIRONMENT CONFIGURATION TEMPLATE
# SPBP Polda Papua Barat
# ==============================================================================

# Application Environment & Server Port
NODE_ENV=development
PORT=4000

# ------------------------------------------------------------------------------
# Database Configuration (MySQL / MariaDB)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=password
DB_NAME=fuel_monitoring
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ------------------------------------------------------------------------------
# Secondary Database Configuration (Enabler FMS / enablerujb)
# ------------------------------------------------------------------------------
ENABLER_DB_HOST=localhost
ENABLER_DB_PORT=3306
ENABLER_DB_USER=root
ENABLER_DB_PASS=password
ENABLER_DB_NAME=enablerujb
ENABLER_DB_SYNCHRONIZE=false
ENABLER_DB_LOGGING=false

# ------------------------------------------------------------------------------
# Pertamina Forecourt Management System (FMS) / Controller API Integration
# ------------------------------------------------------------------------------
# Target Base URL of the CodeIgniter 3 Forecourt Controller API (e.g. http://192.168.1.100/api)
FMS_BASE_URL=http://localhost/api
# Request timeout in milliseconds (default: 15000)
FMS_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# Hardware Controller Secret (Legacy / Direct Push Authentication)
# ------------------------------------------------------------------------------
CONTROLLER_SECRET=spbp-controller-2026

# ------------------------------------------------------------------------------
# JWT Authentication & Session Security
# ------------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=8h

# ------------------------------------------------------------------------------
# CORS Allowed Origins (Comma-separated for multiple origins)
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# API Rate Limiting & Throttling
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
